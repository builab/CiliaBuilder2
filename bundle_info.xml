<?xml version="1.0" encoding="UTF-8"?>
<BundleInfo
    name="ChimeraX-CiliaBuilder2"
    version="0.2.5"
    package="chimerax.ciliabuilder2"
    minSessionVersion="1"
    maxSessionVersion="999">

  <Author>Bui lab@McGill</Author>
  <Email>huy.bui@mcgill.ca</Email>
  <URL>https://github.com/builab/CiliaBuilder2</URL>

  <Synopsis>Cilia Model Builder</Synopsis>

  <Description>
    Implements CiliaBuilder2 workflows in ChimeraX for STAR-guided cilia model
    building, membrane generation, geometric drawing, attachment, and session
    restore.
  </Description>

  <Categories>
    <Category name="EM, Structure Analysis, Visualization"/>
  </Categories>
  
  <!-- Dependencies on other ChimeraX/Python packages.
       Minimum ChimeraX is 1.7. All ChimeraX APIs used by CiliaBuilder2 exist in 1.7,
       and the source compiles with Python 3.11 (shipped with 1.7). Each bundle is
       pinned to the version it has in ChimeraX 1.7, so these are always satisfied
       by the ChimeraX installation itself (bundle versions differ from the ChimeraX
       version, e.g. ChimeraX-UI is 1.33 in ChimeraX 1.7).
       numpy is the only third-party package used; ChimeraX 1.7 ships numpy 1.25.1.
       Do not raise the numpy pin above what ChimeraX ships, or pip will try to
       replace ChimeraX's own numpy on install. -->
  <Dependencies>
    <Dependency name="ChimeraX-Core" version=">=1.7"/>
    <Dependency name="ChimeraX-UI" version=">=1.33"/>
    <Dependency name="ChimeraX-Atomic" version=">=1.49"/>
    <Dependency name="ChimeraX-CellPack" version=">=1.0"/>
    <Dependency name="ChimeraX-Geometry" version=">=1.3"/>
    <Dependency name="ChimeraX-gltf" version=">=1.0"/>
    <Dependency name="ChimeraX-Graphics" version=">=1.1"/>
    <Dependency name="ChimeraX-Map" version=">=1.1"/>
    <Dependency name="ChimeraX-Markers" version=">=1.0"/>
    <Dependency name="ChimeraX-Shape" version=">=1.0"/>
    <Dependency name="ChimeraX-STL" version=">=1.0"/>
    <Dependency name="ChimeraX-Surface" version=">=1.0"/>
    <Dependency name="numpy" version=">=1.25"/>
  </Dependencies>

  <DataFiles>
    <DataFile>docs/user/*.html</DataFile>
    <DataFile>docs/user/*.svg</DataFile>
    <DataFile>docs/user/*.png</DataFile>
    <DataFile>docs/user/general/*.html</DataFile>
    <DataFile>docs/user/tools/*.html</DataFile>
    <DataFile>docs/user/cmd/*.html</DataFile>
  </DataFiles>

  <Classifiers>
    <PythonClassifier>Development Status :: 4 - Beta</PythonClassifier>
    <PythonClassifier>License :: Freeware</PythonClassifier>
    <ChimeraXClassifier>ChimeraX :: Tool :: CiliaBuilder2 :: Higher-Order Structure :: Cilia Model Builder</ChimeraXClassifier>
    <ChimeraXClassifier>ChimeraX :: Command :: cbstraight :: General :: Build microtubule STAR models</ChimeraXClassifier>
    <ChimeraXClassifier>ChimeraX :: Command :: buildcentralpair :: General :: Build central-pair STAR models</ChimeraXClassifier>
    <ChimeraXClassifier>ChimeraX :: Command :: cbui :: General :: Open the CiliaBuilder2 tool</ChimeraXClassifier>
    <ChimeraXClassifier>ChimeraX :: Command :: cbopenapr :: General :: Open a local cellPACK/APR package</ChimeraXClassifier>
  </Classifiers>

</BundleInfo>
