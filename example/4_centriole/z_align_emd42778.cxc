# Script to align EMD-42778 proximal triplet so the longitudinal axis parallel to the Z axis
# This needs to be done together with EMD-42776
# Reset the session
close all

# Fetch the map from EMDB
open emdb:42776

# Copy volume
volume copy #1

# Rotate around z
roll y -4.25 1 models #2; wait;

# Rotate around x
roll x -2 1 models #2; wait;

# Rotate around z
roll z 140 1 models #2; wait;

# Resample to keep the rotated volume
volume resample #2 onGrid #1

# Copy volume
open emdb:42778

# Rotate around z
roll y -4 1 models #4; wait;

# Rotate around x
roll x -3.5 1 models #4; wait;

# Rotate around z
roll z 142 1 models #4; wait;

# Move down
move x 70 1 models #4; wait;

move y -20 1 models #4; wait;

# Fit 42778 to Z-aligned 42776
fit #4 inmap #3

# Resample to keep the rotated volume
volume resample #4 onGrid #3

# Save rotated volume
save ~/Desktop/emd_42778_zaligned.mrc models #5