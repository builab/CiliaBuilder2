# ===================================================================
#  Chlamydomonas .8 um long cilium with IFT trains - showcase movie
#  CiliaBuilder2 session, ChimeraX.  ciliabuilder2_Chlamy_long_glb_with_IFT.json
#
#  Models:
#    #6.2.6         doublet microtubules
#    #6.2.7         central pair
#    #6.2.8, #6.2.9   anterograde train 1 (IFT-B, IFT-A) on doublet 3
#    #6.2.10,#6.2.11  anterograde train 2 (IFT-B, IFT-A) on doublet 1
#    #6.2.12        retrograde train
# Run this file first to prepare the movie
# Then run the file chlamy_cilium_ift_movie_record.cxc to record the movie
# ===================================================================

# ---------- 0. Look  ---------------------------------
windowsize 1920 1080; wait;
set bgColor black;
lighting soft;
cofr #6.2.6; 

# ---------- Camera positions  ------------------------
# Cross-section: look straight down the cilium axis.
view orient; wait;
roll z 80 1; wait;
view #6.2.6,7; wait;
zoom 1.2 1; wait;
view name xsec; wait;

# Side view: cilium horizontal. Tip to the right
turn y 90 1; wait;
turn x 60 1; wait;
view name side_zoom; wait;

view #6.2.6-12; wait;
view name side; wait;

# Close-ups of each train (same side orientation).
turn x -40 1; wait;
view #6.2.8,9 pad 0.4; wait;
view name ant1; wait;
roll x 80 1; wait;
view #6.2.10,11 pad 0.4; wait;
view name ant2; wait;
roll x -40 1; wait;
view #6.2.12 pad 0.4; wait;
view name retro; wait;
